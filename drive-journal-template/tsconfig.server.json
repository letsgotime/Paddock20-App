{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "outDir": "dist",
    "isolatedModules": false,
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["server", "shared"]
}